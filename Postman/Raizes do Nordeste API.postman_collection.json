{
  "info": {
    "name": "Raizes do Nordeste API",
    "description": "Colecao de testes do Projeto Multidisciplinar - Trilha Back-End (Fluxo B: Estoque por Unidade). 11 cenarios (6 positivos, 5 negativos). Execute na ordem: Auth -> Produtos -> Estoque -> Auditoria.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8090" },
    { "key": "adminToken", "value": "" },
    { "key": "clienteToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "T01 - Login valido (ADMIN)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 200', () => pm.response.to.have.status(200));",
                "pm.test('accessToken presente', () => pm.expect(pm.response.json().accessToken).to.be.a('string'));",
                "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@raizesdonordeste.com\",\n  \"senha\": \"admin123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "T01b - Login valido (CLIENTE, para o teste de 403)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 200', () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set('clienteToken', pm.response.json().accessToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente@raizesdonordeste.com\",\n  \"senha\": \"cliente123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "T02 - Login com senha incorreta (401)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 401', () => pm.response.to.have.status(401));",
                "pm.test('erro CREDENCIAIS_INVALIDAS', () => pm.expect(pm.response.json().error).to.eql('CREDENCIAIS_INVALIDAS'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@raizesdonordeste.com\",\n  \"senha\": \"senhaerrada\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "T03 - Criar produto (201)",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Suco de Caju\",\n  \"descricao\": \"Suco natural de caju\",\n  \"preco\": 6.5\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "T04 - Preco invalido (422)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 422', () => pm.response.to.have.status(422));",
                "pm.test('erro DADOS_INVALIDOS', () => pm.expect(pm.response.json().error).to.eql('DADOS_INVALIDOS'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Suco\",\n  \"preco\": -1\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "T05 - Listar produtos paginado (200)",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/produtos?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["produtos"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "T10 - Produto inexistente (404)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 404', () => pm.response.to.have.status(404));",
                "pm.test('erro PRODUTO_NAO_ENCONTRADO', () => pm.expect(pm.response.json().error).to.eql('PRODUTO_NAO_ENCONTRADO'));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/produtos/9999", "host": ["{{baseUrl}}"], "path": ["produtos", "9999"] }
          }
        }
      ]
    },
    {
      "name": "Estoque",
      "item": [
        {
          "name": "T06 - Movimentar ENTRADA (ADMIN) - 201",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 201', () => pm.response.to.have.status(201));",
                "pm.test('saldoResultante presente', () => pm.expect(pm.response.json().saldoResultante).to.be.a('number'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"produtoId\": 1,\n  \"unidadeId\": 1,\n  \"tipo\": \"ENTRADA\",\n  \"quantidade\": 50\n}" },
            "url": { "raw": "{{baseUrl}}/estoques/movimentacoes", "host": ["{{baseUrl}}"], "path": ["estoques", "movimentacoes"] }
          }
        },
        {
          "name": "T07 - Movimentar sem token (401)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 401', () => pm.response.to.have.status(401));",
                "pm.test('erro NAO_AUTENTICADO', () => pm.expect(pm.response.json().error).to.eql('NAO_AUTENTICADO'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"produtoId\": 1,\n  \"unidadeId\": 1,\n  \"tipo\": \"ENTRADA\",\n  \"quantidade\": 50\n}" },
            "url": { "raw": "{{baseUrl}}/estoques/movimentacoes", "host": ["{{baseUrl}}"], "path": ["estoques", "movimentacoes"] }
          }
        },
        {
          "name": "T08 - Movimentar com perfil CLIENTE (403)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 403', () => pm.response.to.have.status(403));",
                "pm.test('erro SEM_PERMISSAO', () => pm.expect(pm.response.json().error).to.eql('SEM_PERMISSAO'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clienteToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"produtoId\": 1,\n  \"unidadeId\": 1,\n  \"tipo\": \"ENTRADA\",\n  \"quantidade\": 50\n}" },
            "url": { "raw": "{{baseUrl}}/estoques/movimentacoes", "host": ["{{baseUrl}}"], "path": ["estoques", "movimentacoes"] }
          }
        },
        {
          "name": "T09 - Saida maior que o saldo (409)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 409', () => pm.response.to.have.status(409));",
                "pm.test('erro ESTOQUE_INSUFICIENTE', () => pm.expect(pm.response.json().error).to.eql('ESTOQUE_INSUFICIENTE'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"produtoId\": 1,\n  \"unidadeId\": 1,\n  \"tipo\": \"SAIDA\",\n  \"quantidade\": 9999\n}" },
            "url": { "raw": "{{baseUrl}}/estoques/movimentacoes", "host": ["{{baseUrl}}"], "path": ["estoques", "movimentacoes"] }
          }
        }
      ]
    },
    {
      "name": "Auditoria",
      "item": [
        {
          "name": "T11 - Listar logs (ADMIN) - 200",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 200', () => pm.response.to.have.status(200));",
                "pm.test('contem MOVIMENTACAO_ESTOQUE', () => {",
                "  const acoes = pm.response.json().content.map(l => l.acao);",
                "  pm.expect(acoes).to.include('MOVIMENTACAO_ESTOQUE');",
                "});"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/auditoria?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["auditoria"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        }
      ]
    }
  ]
}
