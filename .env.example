# Copie este arquivo para .env (ou exporte as variaveis no seu ambiente/IDE)
# NUNCA commitar o arquivo .env de verdade - ele ja esta no .gitignore

DB_NAME=raizes_nordeste
DB_USERNAME=root
DB_PASSWORD=sua_senha_local_do_mysql

SERVER_PORT=8090

# Gere uma string aleatoria longa (min. 32 caracteres) para o segredo do JWT
JWT_SECRET=troque-por-uma-string-secreta-bem-grande-e-aleatoria
JWT_EXPIRATION_MS=3600000
